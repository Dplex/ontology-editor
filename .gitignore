# ---- secrets (never commit) ----
.env
.env.*
# 편집기와 파일 관리자는 사본을 ".env copy", ".env - Copy" 처럼 만든다.
# 어느 것도 ".env.*" 에 걸리지 않아서, 자격증명이 든 파일이 평범한 untracked 파일처럼
# 작업 트리에 남는다.
.env*
!.env.example
*.pem
*.key
credentials.json

# ---- Node / Vue ----
node_modules/
dist/
.vite/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- E2E (Playwright) ----
# 실패했을 때만 생기는 산출물이다. trace.zip 은 원인을 좇을 때 필요하지만 그건 그 자리에서
# 보는 것이고, 저장소에 남길 것은 아니다.
test-results/
playwright-report/
# 눈으로 확인할 때 쓰는 스크린샷. 기계마다 달라서 기록은 docs 에 남긴다.
shots/

# ---- editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- local data ----
# 열어 보려고 끌어다 둔 온톨로지 원본. 정본은 ieum-pipeline/data/ontology 에 있다.
/data/
