<?xml version="1.0" encoding="UTF-8"?>
<!-- 만드는 법: 정본 docs/bim-to-dt-ontology.md 4장의 R 번호를 옮겼다. 열거값은 IFC4·IFC4X3_ADD2 스키마에서 읽었다. -->
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>DT 온톨로지용 BIM 요구사항</title>
    <version>0.5 (초안)</version>
    <description>BIM(IFC4)에서 DT 공간 온톨로지(Brick TTL + GeoJSON)를 만들기 위해 고객사 BIM 에 요구하는 것. 이름의 [필수]·[권장] 과 R 번호는 docs/bim-to-dt-ontology.md 4장을 따른다. IFC2x3 파일에도 걸린다(지도 변환과 계통 종류는 IFC4 부터 있는 자리라 IFC4 에만). 기하로만 확인하는 요구(R2 외곽선, R7 스캔 정합, R8, R11 배치점 위치, R12, R15)와 IDS 가 담지 못하는 요구(R0 구문, R5 공간 경계, R10 스키마, R13 GUID 유지, R18, R20)는 이 파일에 없다.</description>
    <date>2026-09-29</date>
    <purpose>고객사 BIM 납품 전 자가 검사</purpose>
  </info>
  <specifications>
    <specification name="[필수] R1 층 이름" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R1" description="층이 있고 이름이 있어야 한다. 층 표기 규칙(예: B1, 1F, RF)은 프로젝트마다 정해 value 에 넣는다.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute instructions="DT 의 층 표기와 같게, 건축·설비 파일끼리도 같게 적는다. 층은 이름으로 맞춘다(GlobalId 는 분야별 파일마다 달라서 쓸 수 없다)."><name><simpleValue>Name</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="[필수] R2 공간이 층에 속함" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R2" description="공간(IfcSpace)이 있고 층에 묶여 있어야 한다. 바닥 외곽선(FootPrint 또는 Body/SweptSolid)은 IDS 로 확인할 수 없어 따로 연다. 건축·설비를 파일로 나눠 내면 공간이 든 파일(보통 건축)에서 본다. 공간이 없는 설비 파일은 이 명세에서 떨어진다.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSPACE</simpleValue></name></entity>
      </applicability>
      <requirements>
        <partOf relation="IFCRELAGGREGATES" instructions="IfcSpace 는 IfcRelAggregates 로 층 아래에 둔다."><entity><name><simpleValue>IFCBUILDINGSTOREY</simpleValue></name></entity></partOf>
      </requirements>
    </specification>
    <specification name="[필수] R3 공간 이름과 방 번호" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R3" description="방 번호(Name)와 방 이름(LongName). 합칠 때 방 번호로 외곽선을 빌려 온다.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSPACE</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute instructions="방 번호. 건축·설비 파일끼리 같게 적는다."><name><simpleValue>Name</simpleValue></name></attribute>
        <attribute instructions="방 이름(예: 회의실)."><name><simpleValue>LongName</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="[필수] R3 방 이름에 기본값을 두지 않음" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R3" description="저작 도구가 채운 기본 이름(Revit 의 공간·Space·Room)은 어느 방도 가리키지 않는다. 이름이 이것뿐인 공간이 있으면 떨어진다. Revit 의 공간(MEP Space)은 방(Room) 이름을 받아 오게 하거나 지운다.">
      <applicability minOccurs="0" maxOccurs="0">
        <entity><name><simpleValue>IFCSPACE</simpleValue></name></entity>
        <attribute><name><simpleValue>LongName</simpleValue></name><value><xs:restriction base="xs:string"><xs:enumeration value="공간"/><xs:enumeration value="방"/><xs:enumeration value="Space"/><xs:enumeration value="SPACE"/><xs:enumeration value="space"/><xs:enumeration value="Room"/><xs:enumeration value="ROOM"/><xs:enumeration value="room"/></xs:restriction></value></attribute>
      </applicability>
    </specification>
    <specification name="[필수] R4 문·창이 벽 개구부에 끼워짐" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R4" description="문·창이 개구부를 거쳐 벽에 걸려 있어야 한다. 로봇 통과 여부(F15)와 방-문-방 연결에 쓴다.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><xs:restriction base="xs:string"><xs:enumeration value="IFCDOOR"/><xs:enumeration value="IFCWINDOW"/></xs:restriction></name></entity>
      </applicability>
      <requirements>
        <partOf relation="IFCRELVOIDSELEMENT IFCRELFILLSELEMENT" instructions="문·창은 IfcOpeningElement 를 거쳐 벽에 끼운다."><entity><name><xs:restriction base="xs:string"><xs:pattern value="IFC[A-Z]+"/></xs:restriction></name></entity></partOf>
      </requirements>
    </specification>
    <specification name="[필수] R6 길이 단위 선언" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R6" description="프로젝트에 단위 선언이 있어야 한다.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCPROJECT</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute instructions="IfcUnitAssignment 에 길이 단위를 선언한다. 없으면 좌표가 1,000배나 3.28배로 들어온다."><name><simpleValue>UnitsInContext</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="[필수] R7 지도 좌표 변환" ifcVersion="IFC4 IFC4X3_ADD2" identifier="R7" description="IfcMapConversion(LoGeoRef 50)이 있어야 한다. IFC4 부터 있는 자리다. 3D 스캔과 원점·북방향이 맞는지는 IDS 로 확인할 수 없다. 합의한 기준점으로 대신하기로 했다면 이 항목은 빼고 검사한다.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCMAPCONVERSION</simpleValue></name></entity>
      </applicability>
      <requirements>
        <attribute><name><simpleValue>Eastings</simpleValue></name></attribute>
        <attribute><name><simpleValue>Northings</simpleValue></name></attribute>
        <attribute instructions="북방향. 3D 스캔과 같은 북방향이어야 한다."><name><simpleValue>XAxisAbscissa</simpleValue></name></attribute>
        <attribute><name><simpleValue>XAxisOrdinate</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="[필수] R9 설비 포함" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R9" description="설비 파일에 설비가 한 대 이상 있어야 한다. 건축 파일은 이 항목에서 실패하는 것이 맞다.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity><name><xs:restriction base="xs:string"><xs:enumeration value="IFCACTUATOR"/><xs:enumeration value="IFCAIRTERMINAL"/><xs:enumeration value="IFCAIRTERMINALBOX"/><xs:enumeration value="IFCAIRTOAIRHEATRECOVERY"/><xs:enumeration value="IFCALARM"/><xs:enumeration value="IFCAUDIOVISUALAPPLIANCE"/><xs:enumeration value="IFCBOILER"/><xs:enumeration value="IFCBURNER"/><xs:enumeration value="IFCCHILLER"/><xs:enumeration value="IFCCOIL"/><xs:enumeration value="IFCCOMMUNICATIONSAPPLIANCE"/><xs:enumeration value="IFCCOMPRESSOR"/><xs:enumeration value="IFCCONDENSER"/><xs:enumeration value="IFCCONTROLLER"/><xs:enumeration value="IFCCOOLEDBEAM"/><xs:enumeration value="IFCCOOLINGTOWER"/><xs:enumeration value="IFCDAMPER"/><xs:enumeration value="IFCDISTRIBUTIONBOARD"/><xs:enumeration value="IFCDISTRIBUTIONCHAMBERELEMENT"/><xs:enumeration value="IFCDISTRIBUTIONCONTROLELEMENT"/><xs:enumeration value="IFCDISTRIBUTIONFLOWELEMENT"/><xs:enumeration value="IFCDUCTSILENCER"/><xs:enumeration value="IFCELECTRICAPPLIANCE"/><xs:enumeration value="IFCELECTRICDISTRIBUTIONBOARD"/><xs:enumeration value="IFCELECTRICDISTRIBUTIONPOINT"/><xs:enumeration value="IFCELECTRICFLOWSTORAGEDEVICE"/><xs:enumeration value="IFCELECTRICFLOWTREATMENTDEVICE"/><xs:enumeration value="IFCELECTRICGENERATOR"/><xs:enumeration value="IFCELECTRICMOTOR"/><xs:enumeration value="IFCELECTRICTIMECONTROL"/><xs:enumeration value="IFCENERGYCONVERSIONDEVICE"/><xs:enumeration value="IFCENGINE"/><xs:enumeration value="IFCEVAPORATIVECOOLER"/><xs:enumeration value="IFCEVAPORATOR"/><xs:enumeration value="IFCFAN"/><xs:enumeration value="IFCFILTER"/><xs:enumeration value="IFCFIRESUPPRESSIONTERMINAL"/><xs:enumeration value="IFCFLOWCONTROLLER"/><xs:enumeration value="IFCFLOWINSTRUMENT"/><xs:enumeration value="IFCFLOWMETER"/><xs:enumeration value="IFCFLOWMOVINGDEVICE"/><xs:enumeration value="IFCFLOWSTORAGEDEVICE"/><xs:enumeration value="IFCFLOWTERMINAL"/><xs:enumeration value="IFCFLOWTREATMENTDEVICE"/><xs:enumeration value="IFCHEATEXCHANGER"/><xs:enumeration value="IFCHUMIDIFIER"/><xs:enumeration value="IFCINTERCEPTOR"/><xs:enumeration value="IFCJUNCTIONBOX"/><xs:enumeration value="IFCLAMP"/><xs:enumeration value="IFCLIGHTFIXTURE"/><xs:enumeration value="IFCLIQUIDTERMINAL"/><xs:enumeration value="IFCMEDICALDEVICE"/><xs:enumeration value="IFCMOBILETELECOMMUNICATIONSAPPLIANCE"/><xs:enumeration value="IFCMOTORCONNECTION"/><xs:enumeration value="IFCOUTLET"/><xs:enumeration value="IFCPROTECTIVEDEVICE"/><xs:enumeration value="IFCPROTECTIVEDEVICETRIPPINGUNIT"/><xs:enumeration value="IFCPUMP"/><xs:enumeration value="IFCSANITARYTERMINAL"/><xs:enumeration value="IFCSENSOR"/><xs:enumeration value="IFCSIGNAL"/><xs:enumeration value="IFCSOLARDEVICE"/><xs:enumeration value="IFCSPACEHEATER"/><xs:enumeration value="IFCSTACKTERMINAL"/><xs:enumeration value="IFCSWITCHINGDEVICE"/><xs:enumeration value="IFCTANK"/><xs:enumeration value="IFCTRANSFORMER"/><xs:enumeration value="IFCTUBEBUNDLE"/><xs:enumeration value="IFCUNITARYCONTROLELEMENT"/><xs:enumeration value="IFCUNITARYEQUIPMENT"/><xs:enumeration value="IFCVALVE"/><xs:enumeration value="IFCWASTETERMINAL"/></xs:restriction></name></entity>
      </applicability>
    </specification>
    <specification name="[필수] R11 설비마다 배치" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R11" description="설비에 배치가 있어야 한다. 배치점이 자기 형상 위에 있는지는 IDS 로 확인할 수 없어 따로 연다.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><xs:restriction base="xs:string"><xs:enumeration value="IFCACTUATOR"/><xs:enumeration value="IFCAIRTERMINAL"/><xs:enumeration value="IFCAIRTERMINALBOX"/><xs:enumeration value="IFCAIRTOAIRHEATRECOVERY"/><xs:enumeration value="IFCALARM"/><xs:enumeration value="IFCAUDIOVISUALAPPLIANCE"/><xs:enumeration value="IFCBOILER"/><xs:enumeration value="IFCBURNER"/><xs:enumeration value="IFCCHILLER"/><xs:enumeration value="IFCCOIL"/><xs:enumeration value="IFCCOMMUNICATIONSAPPLIANCE"/><xs:enumeration value="IFCCOMPRESSOR"/><xs:enumeration value="IFCCONDENSER"/><xs:enumeration value="IFCCONTROLLER"/><xs:enumeration value="IFCCOOLEDBEAM"/><xs:enumeration value="IFCCOOLINGTOWER"/><xs:enumeration value="IFCDAMPER"/><xs:enumeration value="IFCDISTRIBUTIONBOARD"/><xs:enumeration value="IFCDISTRIBUTIONCHAMBERELEMENT"/><xs:enumeration value="IFCDISTRIBUTIONCONTROLELEMENT"/><xs:enumeration value="IFCDISTRIBUTIONFLOWELEMENT"/><xs:enumeration value="IFCDUCTSILENCER"/><xs:enumeration value="IFCELECTRICAPPLIANCE"/><xs:enumeration value="IFCELECTRICDISTRIBUTIONBOARD"/><xs:enumeration value="IFCELECTRICDISTRIBUTIONPOINT"/><xs:enumeration value="IFCELECTRICFLOWSTORAGEDEVICE"/><xs:enumeration value="IFCELECTRICFLOWTREATMENTDEVICE"/><xs:enumeration value="IFCELECTRICGENERATOR"/><xs:enumeration value="IFCELECTRICMOTOR"/><xs:enumeration value="IFCELECTRICTIMECONTROL"/><xs:enumeration value="IFCENERGYCONVERSIONDEVICE"/><xs:enumeration value="IFCENGINE"/><xs:enumeration value="IFCEVAPORATIVECOOLER"/><xs:enumeration value="IFCEVAPORATOR"/><xs:enumeration value="IFCFAN"/><xs:enumeration value="IFCFILTER"/><xs:enumeration value="IFCFIRESUPPRESSIONTERMINAL"/><xs:enumeration value="IFCFLOWCONTROLLER"/><xs:enumeration value="IFCFLOWINSTRUMENT"/><xs:enumeration value="IFCFLOWMETER"/><xs:enumeration value="IFCFLOWMOVINGDEVICE"/><xs:enumeration value="IFCFLOWSTORAGEDEVICE"/><xs:enumeration value="IFCFLOWTERMINAL"/><xs:enumeration value="IFCFLOWTREATMENTDEVICE"/><xs:enumeration value="IFCHEATEXCHANGER"/><xs:enumeration value="IFCHUMIDIFIER"/><xs:enumeration value="IFCINTERCEPTOR"/><xs:enumeration value="IFCJUNCTIONBOX"/><xs:enumeration value="IFCLAMP"/><xs:enumeration value="IFCLIGHTFIXTURE"/><xs:enumeration value="IFCLIQUIDTERMINAL"/><xs:enumeration value="IFCMEDICALDEVICE"/><xs:enumeration value="IFCMOBILETELECOMMUNICATIONSAPPLIANCE"/><xs:enumeration value="IFCMOTORCONNECTION"/><xs:enumeration value="IFCOUTLET"/><xs:enumeration value="IFCPROTECTIVEDEVICE"/><xs:enumeration value="IFCPROTECTIVEDEVICETRIPPINGUNIT"/><xs:enumeration value="IFCPUMP"/><xs:enumeration value="IFCSANITARYTERMINAL"/><xs:enumeration value="IFCSENSOR"/><xs:enumeration value="IFCSIGNAL"/><xs:enumeration value="IFCSOLARDEVICE"/><xs:enumeration value="IFCSPACEHEATER"/><xs:enumeration value="IFCSTACKTERMINAL"/><xs:enumeration value="IFCSWITCHINGDEVICE"/><xs:enumeration value="IFCTANK"/><xs:enumeration value="IFCTRANSFORMER"/><xs:enumeration value="IFCTUBEBUNDLE"/><xs:enumeration value="IFCUNITARYCONTROLELEMENT"/><xs:enumeration value="IFCUNITARYEQUIPMENT"/><xs:enumeration value="IFCVALVE"/><xs:enumeration value="IFCWASTETERMINAL"/></xs:restriction></name></entity>
      </applicability>
      <requirements>
        <attribute instructions="설비마다 배치를 준다. 배치점은 자기 형상 위에 둔다(층 원점에 두지 않는다)."><name><simpleValue>ObjectPlacement</simpleValue></name></attribute>
      </requirements>
    </specification>
    <specification name="[권장] R14 방 분류" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R14" description="방 분류가 있으면 방이 brick:Office 같은 하위 클래스로 나간다. 없으면 이름 사전으로만 읽고, 사전이 모르면 brick:Room 이다. 병원 건축(Revit)은 269개 방 전부에 코드를 적었고, 이름 사전이 모르는 방 55개를 코드가 말했다.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCSPACE</simpleValue></name></entity>
      </applicability>
      <requirements>
        <classification instructions="OmniClass Table 13 코드를 IfcClassificationReference 로 단다(Identification 에 13-15 11 34 11 처럼). IfcClassification.Name 은 OmniClass 로 적는다. Revit 은 방마다 OmniClass Table 13 Category 속성에 이 코드를 이미 채운다(속성으로만 나오면 이 검사에서는 떨어지지만 우리는 읽는다)."><value><xs:restriction base="xs:string"><xs:pattern value="13-\d{2}( \d{2})*.*"/></xs:restriction></value><system><xs:restriction base="xs:string"><xs:pattern value="OmniClass.*"/></xs:restriction></system></classification>
      </requirements>
    </specification>
    <specification name="[권장] R16 설비·도관이 계통에 묶임" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" identifier="R16" description="어느 설비가 어느 계통인지. 규칙 방향(계통 종류로 흐름 방향을 정한다)의 입력이다.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><xs:restriction base="xs:string"><xs:enumeration value="IFCACTUATOR"/><xs:enumeration value="IFCAIRTERMINAL"/><xs:enumeration value="IFCAIRTERMINALBOX"/><xs:enumeration value="IFCAIRTOAIRHEATRECOVERY"/><xs:enumeration value="IFCALARM"/><xs:enumeration value="IFCAUDIOVISUALAPPLIANCE"/><xs:enumeration value="IFCBOILER"/><xs:enumeration value="IFCBURNER"/><xs:enumeration value="IFCCABLECARRIERFITTING"/><xs:enumeration value="IFCCABLECARRIERSEGMENT"/><xs:enumeration value="IFCCABLEFITTING"/><xs:enumeration value="IFCCABLESEGMENT"/><xs:enumeration value="IFCCHILLER"/><xs:enumeration value="IFCCOIL"/><xs:enumeration value="IFCCOMMUNICATIONSAPPLIANCE"/><xs:enumeration value="IFCCOMPRESSOR"/><xs:enumeration value="IFCCONDENSER"/><xs:enumeration value="IFCCONTROLLER"/><xs:enumeration value="IFCCONVEYORSEGMENT"/><xs:enumeration value="IFCCOOLEDBEAM"/><xs:enumeration value="IFCCOOLINGTOWER"/><xs:enumeration value="IFCDAMPER"/><xs:enumeration value="IFCDISTRIBUTIONBOARD"/><xs:enumeration value="IFCDISTRIBUTIONCHAMBERELEMENT"/><xs:enumeration value="IFCDISTRIBUTIONCONTROLELEMENT"/><xs:enumeration value="IFCDISTRIBUTIONFLOWELEMENT"/><xs:enumeration value="IFCDUCTFITTING"/><xs:enumeration value="IFCDUCTSEGMENT"/><xs:enumeration value="IFCDUCTSILENCER"/><xs:enumeration value="IFCELECTRICAPPLIANCE"/><xs:enumeration value="IFCELECTRICDISTRIBUTIONBOARD"/><xs:enumeration value="IFCELECTRICDISTRIBUTIONPOINT"/><xs:enumeration value="IFCELECTRICFLOWSTORAGEDEVICE"/><xs:enumeration value="IFCELECTRICFLOWTREATMENTDEVICE"/><xs:enumeration value="IFCELECTRICGENERATOR"/><xs:enumeration value="IFCELECTRICMOTOR"/><xs:enumeration value="IFCELECTRICTIMECONTROL"/><xs:enumeration value="IFCENERGYCONVERSIONDEVICE"/><xs:enumeration value="IFCENGINE"/><xs:enumeration value="IFCEVAPORATIVECOOLER"/><xs:enumeration value="IFCEVAPORATOR"/><xs:enumeration value="IFCFAN"/><xs:enumeration value="IFCFILTER"/><xs:enumeration value="IFCFIRESUPPRESSIONTERMINAL"/><xs:enumeration value="IFCFLOWCONTROLLER"/><xs:enumeration value="IFCFLOWFITTING"/><xs:enumeration value="IFCFLOWINSTRUMENT"/><xs:enumeration value="IFCFLOWMETER"/><xs:enumeration value="IFCFLOWMOVINGDEVICE"/><xs:enumeration value="IFCFLOWSEGMENT"/><xs:enumeration value="IFCFLOWSTORAGEDEVICE"/><xs:enumeration value="IFCFLOWTERMINAL"/><xs:enumeration value="IFCFLOWTREATMENTDEVICE"/><xs:enumeration value="IFCHEATEXCHANGER"/><xs:enumeration value="IFCHUMIDIFIER"/><xs:enumeration value="IFCINTERCEPTOR"/><xs:enumeration value="IFCJUNCTIONBOX"/><xs:enumeration value="IFCLAMP"/><xs:enumeration value="IFCLIGHTFIXTURE"/><xs:enumeration value="IFCLIQUIDTERMINAL"/><xs:enumeration value="IFCMEDICALDEVICE"/><xs:enumeration value="IFCMOBILETELECOMMUNICATIONSAPPLIANCE"/><xs:enumeration value="IFCMOTORCONNECTION"/><xs:enumeration value="IFCOUTLET"/><xs:enumeration value="IFCPIPEFITTING"/><xs:enumeration value="IFCPIPESEGMENT"/><xs:enumeration value="IFCPROTECTIVEDEVICE"/><xs:enumeration value="IFCPROTECTIVEDEVICETRIPPINGUNIT"/><xs:enumeration value="IFCPUMP"/><xs:enumeration value="IFCSANITARYTERMINAL"/><xs:enumeration value="IFCSENSOR"/><xs:enumeration value="IFCSIGNAL"/><xs:enumeration value="IFCSOLARDEVICE"/><xs:enumeration value="IFCSPACEHEATER"/><xs:enumeration value="IFCSTACKTERMINAL"/><xs:enumeration value="IFCSWITCHINGDEVICE"/><xs:enumeration value="IFCTANK"/><xs:enumeration value="IFCTRANSFORMER"/><xs:enumeration value="IFCTUBEBUNDLE"/><xs:enumeration value="IFCUNITARYCONTROLELEMENT"/><xs:enumeration value="IFCUNITARYEQUIPMENT"/><xs:enumeration value="IFCVALVE"/><xs:enumeration value="IFCWASTETERMINAL"/></xs:restriction></name></entity>
      </applicability>
      <requirements>
        <partOf relation="IFCRELASSIGNSTOGROUP" instructions="IfcDistributionSystem 에 IfcRelAssignsToGroup 으로 묶는다. 계통 이름은 건축·설비 파일끼리 같게 적는다."><entity><name><xs:restriction base="xs:string"><xs:pattern value="IFC[A-Z]+"/></xs:restriction></name></entity></partOf>
      </requirements>
    </specification>
    <specification name="[권장] R16 계통 종류" ifcVersion="IFC4 IFC4X3_ADD2" identifier="R16" description="계통 종류를 표준 PredefinedType 으로 준다. NOTDEFINED·USERDEFINED 로 두지 않는다. 배기는 EXHAUST, 급탕·급수는 DOMESTICHOTWATER·DOMESTICCOLDWATER 만으로 정해진다.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCDISTRIBUTIONSYSTEM</simpleValue></name></entity>
      </applicability>
      <requirements>
