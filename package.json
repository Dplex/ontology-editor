    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  }
